<?xml version="1.0" encoding="utf-8"?>
<LanguageData>

  <!-- Menú de ajustes en lote para el mod opcional Drafted Auto-Combat (Alt+T). Actúa sobre
       todos los colonos seleccionados, por eso las filas informan una cuenta y no un sí/no.
       Los nombres de las filas los toma el mod; los de abajo son solo respaldo. -->
  <RimWorldAccess.AutoCombat.Opened>Auto-Combat, {0} colonos.</RimWorldAccess.AutoCombat.Opened>
  <RimWorldAccess.AutoCombat.Hint>Izquierda y derecha aplican a todos. Escape cierra.</RimWorldAccess.AutoCombat.Hint>
  <RimWorldAccess.AutoCombat.Closed>Auto-Combat cerrado.</RimWorldAccess.AutoCombat.Closed>
  <RimWorldAccess.AutoCombat.NotInstalled>Drafted Auto-Combat no está instalado.</RimWorldAccess.AutoCombat.NotInstalled>
  <RimWorldAccess.AutoCombat.NoPawns>Ningún colono seleccionado.</RimWorldAccess.AutoCombat.NoPawns>
  <RimWorldAccess.AutoCombat.SelectionLost>Sin selección. Auto-Combat cerrado.</RimWorldAccess.AutoCombat.SelectionLost>

  <!-- Respaldo si el mod no expone su propia etiqueta. -->
  <RimWorldAccess.AutoCombat.Row.AutoCombat>Auto-Combat</RimWorldAccess.AutoCombat.Row.AutoCombat>
  <RimWorldAccess.AutoCombat.Row.TakeCover>Cobertura</RimWorldAccess.AutoCombat.Row.TakeCover>
  <RimWorldAccess.AutoCombat.Row.MeleeCharge>Carga</RimWorldAccess.AutoCombat.Row.MeleeCharge>
  <RimWorldAccess.AutoCombat.Row.AIControl>Control por IA</RimWorldAccess.AutoCombat.Row.AIControl>
  <RimWorldAccess.AutoCombat.Row.AutoUseAll>Usar habilidades</RimWorldAccess.AutoCombat.Row.AutoUseAll>

  <!-- {0} = nombre, {1} = estado, {2} = posición. -->
  <RimWorldAccess.AutoCombat.Row>{0}: {1}. {2}</RimWorldAccess.AutoCombat.Row>
  <RimWorldAccess.AutoCombat.On>activado</RimWorldAccess.AutoCombat.On>
  <RimWorldAccess.AutoCombat.Off>desactivado</RimWorldAccess.AutoCombat.Off>
  <RimWorldAccess.AutoCombat.OnAll>activado en todos</RimWorldAccess.AutoCombat.OnAll>
  <RimWorldAccess.AutoCombat.OffAll>desactivado en todos</RimWorldAccess.AutoCombat.OffAll>
  <!-- {0} = cuántos lo tienen activado, {1} = cuántos hay seleccionados. -->
  <RimWorldAccess.AutoCombat.OnSome>activado en {0} de {1}</RimWorldAccess.AutoCombat.OnSome>

  <!-- Al aplicar. {0} = nombre, {1} = estado, {2} = cuántos cambiaron. -->
  <RimWorldAccess.AutoCombat.Applied>{0}: {1} en {2}.</RimWorldAccess.AutoCombat.Applied>
  <RimWorldAccess.AutoCombat.NoChange>{0}: ya estaba {1} en todos.</RimWorldAccess.AutoCombat.NoChange>
  <RimWorldAccess.AutoCombat.CouldNotApply>{0}: sin cambios.</RimWorldAccess.AutoCombat.CouldNotApply>
  <RimWorldAccess.AutoCombat.RefusedNoAbilities>{0} sin habilidades compatibles.</RimWorldAccess.AutoCombat.RefusedNoAbilities>
  <RimWorldAccess.AutoCombat.RefusedAIControl>Bloqueado en {0} por Control por IA.</RimWorldAccess.AutoCombat.RefusedAIControl>
  <RimWorldAccess.AutoCombat.RefusedGeneric>Rechazado en {0}.</RimWorldAccess.AutoCombat.RefusedGeneric>

  <!-- Por qué un ajuste puede no hacer nada, dicho junto con la fila. -->
  <RimWorldAccess.AutoCombat.CaveatAutoCombatOff>Sin efecto en {0} sin Auto-Combat.</RimWorldAccess.AutoCombat.CaveatAutoCombatOff>
  <RimWorldAccess.AutoCombat.CaveatAIControl>No disponible en {0} con Control por IA.</RimWorldAccess.AutoCombat.CaveatAIControl>
  <RimWorldAccess.AutoCombat.CaveatNoAbilities>{0} sin habilidades compatibles.</RimWorldAccess.AutoCombat.CaveatNoAbilities>

</LanguageData>
