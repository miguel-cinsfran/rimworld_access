<?xml version="1.0" encoding="utf-8"?>
<LanguageData>

  <!-- Batch settings menu for the optional mod Drafted Auto-Combat (Alt+T). Acts on every
       selected colonist at once, which is why the rows report a count rather than on/off.
       Row names come from the mod itself; the ones below are only a fallback. -->
  <RimWorldAccess.AutoCombat.Opened>Auto-Combat, {0} colonists.</RimWorldAccess.AutoCombat.Opened>
  <RimWorldAccess.AutoCombat.Hint>Left and right apply to all. Escape closes.</RimWorldAccess.AutoCombat.Hint>
  <RimWorldAccess.AutoCombat.Closed>Auto-Combat closed.</RimWorldAccess.AutoCombat.Closed>
  <RimWorldAccess.AutoCombat.NotInstalled>Drafted Auto-Combat is not installed.</RimWorldAccess.AutoCombat.NotInstalled>
  <RimWorldAccess.AutoCombat.NoPawns>No colonist selected.</RimWorldAccess.AutoCombat.NoPawns>
  <RimWorldAccess.AutoCombat.SelectionLost>Nothing selected. Auto-Combat closed.</RimWorldAccess.AutoCombat.SelectionLost>

  <!-- Fallback if the mod doesn't expose its own label. -->
  <RimWorldAccess.AutoCombat.Row.AutoCombat>Auto-Combat</RimWorldAccess.AutoCombat.Row.AutoCombat>
  <RimWorldAccess.AutoCombat.Row.TakeCover>Cover</RimWorldAccess.AutoCombat.Row.TakeCover>
  <RimWorldAccess.AutoCombat.Row.MeleeCharge>Charge</RimWorldAccess.AutoCombat.Row.MeleeCharge>
  <RimWorldAccess.AutoCombat.Row.AIControl>AI control</RimWorldAccess.AutoCombat.Row.AIControl>
  <RimWorldAccess.AutoCombat.Row.AutoUseAll>Use abilities</RimWorldAccess.AutoCombat.Row.AutoUseAll>

  <!-- {0} = label, {1} = state, {2} = position. -->
  <RimWorldAccess.AutoCombat.Row>{0}: {1}. {2}</RimWorldAccess.AutoCombat.Row>
  <RimWorldAccess.AutoCombat.On>on</RimWorldAccess.AutoCombat.On>
  <RimWorldAccess.AutoCombat.Off>off</RimWorldAccess.AutoCombat.Off>
  <RimWorldAccess.AutoCombat.OnAll>on for all</RimWorldAccess.AutoCombat.OnAll>
  <RimWorldAccess.AutoCombat.OffAll>off for all</RimWorldAccess.AutoCombat.OffAll>
  <!-- {0} = how many are on, {1} = how many are selected. -->
  <RimWorldAccess.AutoCombat.OnSome>on for {0} of {1}</RimWorldAccess.AutoCombat.OnSome>

  <!-- Applying. {0} = label, {1} = state, {2} = how many changed. -->
  <RimWorldAccess.AutoCombat.Applied>{0}: {1} for {2}.</RimWorldAccess.AutoCombat.Applied>
  <RimWorldAccess.AutoCombat.NoChange>{0}: already {1} for all.</RimWorldAccess.AutoCombat.NoChange>
  <RimWorldAccess.AutoCombat.CouldNotApply>{0}: no change.</RimWorldAccess.AutoCombat.CouldNotApply>
  <RimWorldAccess.AutoCombat.RefusedNoAbilities>{0} without compatible abilities.</RimWorldAccess.AutoCombat.RefusedNoAbilities>
  <RimWorldAccess.AutoCombat.RefusedAIControl>Blocked for {0} by AI control.</RimWorldAccess.AutoCombat.RefusedAIControl>
  <RimWorldAccess.AutoCombat.RefusedGeneric>Refused for {0}.</RimWorldAccess.AutoCombat.RefusedGeneric>

  <!-- Why a setting may do nothing, spoken with the row. -->
  <RimWorldAccess.AutoCombat.CaveatAutoCombatOff>No effect on {0} without Auto-Combat.</RimWorldAccess.AutoCombat.CaveatAutoCombatOff>
  <RimWorldAccess.AutoCombat.CaveatAIControl>Unavailable for {0} with AI control.</RimWorldAccess.AutoCombat.CaveatAIControl>
  <RimWorldAccess.AutoCombat.CaveatNoAbilities>{0} without compatible abilities.</RimWorldAccess.AutoCombat.CaveatNoAbilities>

</LanguageData>
